{
  "name": "nodered-agents",
  "version": "1.0.0",
  "description": "Private dev workspace for the @tbrandenburg/node-red-agents package (local Node-RED runtime + demo)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node-red --userDir ./data",
    "dev": "nodemon --watch data/nodes --ext js,html,json --exec \"node-red --userDir ./data\"",
    "test": "npm test --workspaces --if-present"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "node-red": "^5.0.9",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "ip-address": "^10.7.4",
    "js-yaml": "^4.3.1",
    "jsonata": "^2.2.2"
  }
}
