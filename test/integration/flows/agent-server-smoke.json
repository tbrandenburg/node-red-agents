  {
    "id": "smoke-agent-server-tab",
    "type": "tab",
    "label": "smoke-agent-server"
  },
  {
    "id": "smoke-agent-server-inject",
    "type": "inject",
    "z": "smoke-agent-server-tab",
    "name": "trigger",
    "props": [
      {
        "p": "payload"
      },
      {
        "p": "operation"
      }
    ],
    "payload": "reply with exactly the word: pong",
    "payloadType": "str",
    "operation": "message",
    "operationType": "str",
    "repeat": "",
    "once": false,
    "wires": [["smoke-agent-server-node"]],
    "x": 100,
    "y": 100
  },
  {
    "id": "smoke-agent-server-node",
    "type": "agent-server",
    "z": "smoke-agent-server-tab",
    "name": "agent-server",
    "operation": "message",
    "model": "opencode/big-pickle",
    "wires": [["smoke-agent-server-lifecycle"], ["smoke-agent-server-events-debug"]],
    "x": 300,
    "y": 100
  },
  {
    "id": "smoke-agent-server-lifecycle",
    "type": "function",
    "z": "smoke-agent-server-tab",
    "name": "exercise history and terminate",
    "func": "if (typeof msg.payload === 'string') {\n    msg.assistantOutput = msg.payload;\n    msg.operation = 'history';\n    return [msg, null];\n}\nif (Array.isArray(msg.payload)) {\n    msg.history = msg.payload;\n    msg.operation = 'abort';\n    return [msg, null];\n}\nif (typeof msg.payload === 'boolean' && msg.operation === 'abort') {\n    msg.abortAcknowledged = msg.payload;\n    msg.operation = 'terminate';\n    return [msg, null];\n}\nreturn [null, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [["smoke-agent-server-node"], ["smoke-agent-server-debug"]],
    "x": 500,
    "y": 100
  },
  {
    "id": "smoke-agent-server-catch",
