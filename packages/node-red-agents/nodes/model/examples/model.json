[
  { "id": "model-example-tab", "type": "tab", "label": "Direct model examples" },
  {
    "id": "model-example-provider",
    "type": "model-provider",
    "name": "Configure API key and model IDs",
    "provider": "openrouter",
    "defaultModel": "",
    "allowedModels": "embedding-model-id",
    "timeout": 60000
  },
  {
    "id": "model-example-inject",
    "type": "inject",
    "z": "model-example-tab",
    "name": "Generate, structured and stream",
    "props": [{ "p": "payload" }],
    "payload": "Give a short friendly greeting.",
    "payloadType": "str",
    "x": 170,
    "y": 100,
    "wires": [["model-example-generate", "model-example-structured", "model-example-stream"]]
  },
  {
    "id": "model-example-generate",
    "type": "model",
    "z": "model-example-tab",
    "name": "Generate",
    "provider": "model-example-provider",
    "operation": "generate",
    "input": "payload",
    "inputType": "msg",
    "inputMode": "prompt",
    "timeout": 0,
    "streaming": false,
    "x": 440,
    "y": 60,
    "wires": [["model-example-result"], []]
  },
  {
    "id": "model-example-structured",
    "type": "model",
    "z": "model-example-tab",
    "name": "Structured",
    "provider": "model-example-provider",
    "operation": "structured",
    "input": "payload",
    "inputType": "msg",
    "inputMode": "prompt",
    "schema": "{\"type\":\"object\",\"properties\":{\"answer\":{\"type\":\"string\"}},\"required\":[\"answer\"],\"additionalProperties\":false}",
    "timeout": 0,
    "streaming": false,
    "x": 440,
    "y": 120,
    "wires": [["model-example-result"], []]
  },
  {
    "id": "model-example-stream",
    "type": "model",
    "z": "model-example-tab",
    "name": "Stream",
    "provider": "model-example-provider",
    "operation": "generate",
    "input": "payload",
    "inputType": "msg",
    "inputMode": "prompt",
    "timeout": 0,
    "streaming": true,
    "x": 440,
    "y": 180,
    "wires": [["model-example-result"], ["model-example-event"]]
  },
  {
    "id": "model-example-embed-inject",
    "type": "inject",
    "z": "model-example-tab",
    "name": "Embed sample",
    "props": [{ "p": "payload" }],
    "payload": "A sample document.",
    "payloadType": "str",
    "x": 160,
    "y": 260,
    "wires": [["model-example-embed"]]
  },
  {
    "id": "model-example-embed",
    "type": "model",
    "z": "model-example-tab",
    "name": "Set real embedding model ID",
    "provider": "model-example-provider",
    "operation": "embed",
    "model": "embedding-model-id",
    "input": "payload",
    "inputType": "msg",
    "inputMode": "prompt",
    "timeout": 0,
    "streaming": false,
    "x": 450,
    "y": 260,
    "wires": [["model-example-result"], []]
  },
  {
    "id": "model-example-result",
    "type": "debug",
    "z": "model-example-tab",
    "name": "Final result",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "true",
    "x": 740,
    "y": 100,
    "wires": []
  },
  {
    "id": "model-example-event",
    "type": "debug",
    "z": "model-example-tab",
    "name": "Stream events",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "modelEvent",
    "targetType": "msg",
    "x": 740,
    "y": 180,
    "wires": []
  },
  {
    "id": "model-example-catch",
    "type": "catch",
    "z": "model-example-tab",
    "name": "Model failures",
    "scope": [
      "model-example-generate",
      "model-example-structured",
      "model-example-stream",
      "model-example-embed"
    ],
    "uncaught": false,
    "x": 450,
    "y": 340,
    "wires": [["model-example-error"]]
  },
  {
    "id": "model-example-error",
    "type": "debug",
    "z": "model-example-tab",
    "name": "Catch errors",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "error",
    "targetType": "msg",
    "x": 730,
    "y": 340,
    "wires": []
  }
]
